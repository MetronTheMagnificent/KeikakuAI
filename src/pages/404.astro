---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada" lang="es">
  <section class="flex flex-col items-center justify-center text-center px-4 py-32">
    <p class="text-8xl font-bold text-indigo-500/30 mb-4" style="font-family:'Space Grotesk',sans-serif;">404</p>
    <h1 class="text-2xl font-bold text-white mb-3" style="font-family:'Space Grotesk',sans-serif;">Página no encontrada</h1>
    <p class="text-slate-400 mb-8">Esta página no existe. Vuelve al inicio.</p>
    <a href="/" class="btn-primary">← Volver al inicio</a>
  </section>
</Layout>
